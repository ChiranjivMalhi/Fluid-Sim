#pragma kernel ApplyForcesIntegrateCollide
#pragma kernel CalculateDensity
#pragma kernel CalculatePressure
#pragma kernel CalculateNearDensities
#pragma kernel CalculateNearPressure
#pragma kernel CalculateViscosity
#pragma kernel CalculateColorField
#pragma kernel CalculateSurfaceTension
#pragma kernel UpdateVelocities
#pragma kernel UpdatePositions
#pragma kernel HashParticles
#pragma kernel BitonicSort
#pragma kernel CalculateOffsets
#pragma kernel ClearOffsets

#include "./SpatialHash3D.hlsl"

RWStructuredBuffer<float3> _Positions;
RWStructuredBuffer<float3> _Velocities;
RWStructuredBuffer<float3> _PredictedPositions;
RWStructuredBuffer<float> _Densities;
RWStructuredBuffer<float> _Pressure;
RWStructuredBuffer<float> _NearDensities;
RWStructuredBuffer<float3> _NearPressureForces;
RWStructuredBuffer<float3> _PressureForces;
RWStructuredBuffer<float3> _ViscosityForces;
RWStructuredBuffer<float3> _ColorFieldNormals;
RWStructuredBuffer<float> _ColorFieldLaplacians;
RWStructuredBuffer<float3> _SurfaceTensionForces;

RWStructuredBuffer<uint> _SortKeys;
RWStructuredBuffer<uint> _SortIndices;
RWStructuredBuffer<uint> _SpatialOffsets;

uint _SortNumEntries;
uint _GroupWidth;
uint _GroupHeight;
uint _StepIndex;

float _DeltaTime;
float _Gravity;
float _DampingFactor;
float _ParticleRadius;
float3 _SimulationBounds;
uint _ParticleCount;
float _SmoothingRadius;
float _RestDensity;
float _PressureMultiplier;
float _ViscosityCoefficient;
float _SurfaceTensionCoefficient;
float _SurfaceTensionThreshold;
float _NearPressureMultiplier;

// Kernel declarations
float DensityKernel(float distance, float radius);
float NearDensityKernel(float distance, float h);
float NearDensityKernelDerivative(float distance, float h);
float SpikyGradient(float r, float h);
float3 ColorFieldKernelNormal(float3 offset, float distSq, float h);
float ColorFieldKernelLaplacian(float distSq, float h);

// ------------------------------------------------------------
// Spatial Hashing & Sorting
// ------------------------------------------------------------
[numthreads(128, 1, 1)]
void HashParticles(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
    {
        _SortKeys[i] = 0xFFFFFFFF;
        _SortIndices[i] = i;
        return;
    }

    int3 cell = GetCell3D(_PredictedPositions[i], _SmoothingRadius);
    uint hash = HashCell3D(cell);
    _SortKeys[i] = KeyFromHash(hash, _ParticleCount);
    _SortIndices[i] = i;
}

[numthreads(128, 1, 1)]
void ClearOffsets(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount)
        return;
    _SpatialOffsets[id.x] = _ParticleCount;
}

[numthreads(128, 1, 1)]
void BitonicSort(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    uint hIndex = i & (_GroupWidth - 1);
    uint indexLeft = hIndex + (_GroupHeight + 1) * (i / _GroupWidth);
    uint rightStepSize = _StepIndex == 0 ? _GroupHeight - 2 * hIndex : (_GroupHeight + 1) / 2;
    uint indexRight = indexLeft + rightStepSize;

    if (indexRight >= _SortNumEntries)
        return;

    uint valueLeft = _SortKeys[indexLeft];
    uint valueRight = _SortKeys[indexRight];

    if (valueLeft > valueRight)
    {
        _SortKeys[indexLeft] = valueRight;
        _SortKeys[indexRight] = valueLeft;

        uint tmpIndex = _SortIndices[indexLeft];
        _SortIndices[indexLeft] = _SortIndices[indexRight];
        _SortIndices[indexRight] = tmpIndex;
    }
}

[numthreads(128, 1, 1)]
void CalculateOffsets(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    uint key = _SortKeys[i];
    uint keyPrev = (i == 0) ? 0xFFFFFFFF : _SortKeys[i - 1];

    if (key != keyPrev)
    {
        _SpatialOffsets[key] = i;
    }
}

[numthreads(128, 1, 1)]
void ApplyForcesIntegrateCollide(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    float3 velocity = _Velocities[i];
    velocity.y -= abs(_Gravity) * _DeltaTime;

    float3 predictedPosition = _Positions[i] + velocity * _DeltaTime;

    float halfWidth  = _SimulationBounds.x * 0.5f;
    float halfHeight = _SimulationBounds.y * 0.5f;
    float halfDepth  = _SimulationBounds.z * 0.5f;

    predictedPosition = clamp(predictedPosition,
        float3(-halfWidth + _ParticleRadius, -halfHeight + _ParticleRadius, -halfDepth + _ParticleRadius),
        float3( halfWidth - _ParticleRadius,  halfHeight - _ParticleRadius,  halfDepth - _ParticleRadius));

    _Velocities[i] = velocity;
    _PredictedPositions[i] = predictedPosition;
}

[numthreads(128, 1, 1)]
void CalculateDensity(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    float density = 0.0f;
    float nearDensity = 0.0f;
    float3 pos = _PredictedPositions[i];
    int3 originCell = GetCell3D(pos, _SmoothingRadius);
    float radiusSq = _SmoothingRadius * _SmoothingRadius;

    for (int offsetIdx = 0; offsetIdx < 27; offsetIdx++)
    {
        uint hash = HashCell3D(originCell + offsets3D[offsetIdx]);
        uint key = KeyFromHash(hash, _ParticleCount);
        uint currIndex = _SpatialOffsets[key];

        for (uint j = currIndex; j < _ParticleCount; j++)
        {
            if (_SortKeys[j] != key)
                break;

            uint neighborIndex = _SortIndices[j];
            float3 diff = _PredictedPositions[neighborIndex] - pos;
            float distSq = dot(diff, diff);

            if (distSq < radiusSq)
            {
                float distance = sqrt(distSq);
                density += DensityKernel(distance, _SmoothingRadius);
                nearDensity += NearDensityKernel(distance, _SmoothingRadius);
            }
        }
    }

    _Densities[i] = density;
    _NearDensities[i] = nearDensity;
}

[numthreads(128, 1, 1)]
void CalculatePressure(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    float density_i = _Densities[i];
    float nearDensity_i = _NearDensities[i];

    float pressure_i = max(0.0f, (density_i - _RestDensity) * _PressureMultiplier);
    float nearPressure_i = nearDensity_i * _NearPressureMultiplier;
    _Pressure[i] = pressure_i;

    float3 pressureForce = float3(0, 0, 0);
    float3 viscosityForce = float3(0, 0, 0);
    float radiusSquared = _SmoothingRadius * _SmoothingRadius;

    float3 pos = _PredictedPositions[i];
    float3 vel = _Velocities[i];
    int3 originCell = GetCell3D(pos, _SmoothingRadius);

    for (int offsetIdx = 0; offsetIdx < 27; offsetIdx++)
    {
        uint hash = HashCell3D(originCell + offsets3D[offsetIdx]);
        uint key = KeyFromHash(hash, _ParticleCount);
        uint currIndex = _SpatialOffsets[key];

        for (uint j = currIndex; j < _ParticleCount; j++)
        {
            if (_SortKeys[j] != key)
                break;

            uint neighborIndex = _SortIndices[j];
            if (i == neighborIndex)
                continue;

            float3 offset = _PredictedPositions[neighborIndex] - pos;
            float distanceSquared = dot(offset, offset);

            if (distanceSquared >= radiusSquared || distanceSquared < 1e-8f)
                continue;

            float distance = sqrt(distanceSquared);
            float3 dirToNeighbour = offset / distance;

            float density_j = _Densities[neighborIndex];
            float nearDensity_j = _NearDensities[neighborIndex];

            float pressure_j = max(0.0f, (density_j - _RestDensity) * _PressureMultiplier);
            float nearPressure_j = nearDensity_j * _NearPressureMultiplier;

            float sharedPressure = (pressure_i + pressure_j) * 0.5f;
            float sharedNearPressure = (nearPressure_i + nearPressure_j) * 0.5f;

            float derivative = SpikyGradient(distance, _SmoothingRadius);
            float nearDerivative = NearDensityKernelDerivative(distance, _SmoothingRadius);

            pressureForce += dirToNeighbour * (derivative * sharedPressure) / max(density_j, 0.001f);
            pressureForce += dirToNeighbour * (nearDerivative * sharedNearPressure) / max(nearDensity_j, 0.001f);

            float3 velDiff = _Velocities[neighborIndex] - vel;
            viscosityForce += velDiff * DensityKernel(distance, _SmoothingRadius);
        }
    }

    _PressureForces[i] = pressureForce;
    _NearPressureForces[i] = float3(0, 0, 0);
    _ViscosityForces[i] = viscosityForce * _ViscosityCoefficient;
}

// Fallback kernels to preserve shader reflection compatibility
[numthreads(128, 1, 1)]
void CalculateNearDensities(uint3 id : SV_DispatchThreadID) { }

[numthreads(128, 1, 1)]
void CalculateNearPressure(uint3 id : SV_DispatchThreadID) { }

[numthreads(128, 1, 1)]
void CalculateViscosity(uint3 id : SV_DispatchThreadID) { }

[numthreads(128, 1, 1)]
void CalculateColorField(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    float3 normal = float3(0, 0, 0);
    float laplacian = 0.0f;
    float radiusSquared = _SmoothingRadius * _SmoothingRadius;

    float3 pos = _PredictedPositions[i];
    int3 originCell = GetCell3D(pos, _SmoothingRadius);

    for (int offsetIdx = 0; offsetIdx < 27; offsetIdx++)
    {
        uint hash = HashCell3D(originCell + offsets3D[offsetIdx]);
        uint key = KeyFromHash(hash, _ParticleCount);
        uint currIndex = _SpatialOffsets[key];

        for (uint j = currIndex; j < _ParticleCount; j++)
        {
            if (_SortKeys[j] != key)
                break;

            uint neighborIndex = _SortIndices[j];
            if (i == neighborIndex)
                continue;

            float3 offset = _PredictedPositions[neighborIndex] - pos;
            float distanceSquared = dot(offset, offset);
            if (distanceSquared >= radiusSquared || distanceSquared < 1e-8f)
                continue;

            float densityJ = max(_Densities[neighborIndex], 0.001f);
            normal += ColorFieldKernelNormal(offset, distanceSquared, _SmoothingRadius) / densityJ;
            laplacian += ColorFieldKernelLaplacian(distanceSquared, _SmoothingRadius) / densityJ;
        }
    }

    _ColorFieldNormals[i] = normal;
    _ColorFieldLaplacians[i] = laplacian;
}

[numthreads(128, 1, 1)]
void CalculateSurfaceTension(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    float3 normal = _ColorFieldNormals[i];
    float laplacian = _ColorFieldLaplacians[i];
    float normalLength = length(normal);

    if (normalLength > _SurfaceTensionThreshold)
    {
        float3 normalizedNormal = normal / normalLength;
        _SurfaceTensionForces[i] = -_SurfaceTensionCoefficient * laplacian * normalizedNormal;
    }
    else
    {
        _SurfaceTensionForces[i] = float3(0, 0, 0);
    }
}

[numthreads(128, 1, 1)]
void UpdateVelocities(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    float3 totalForce = _PressureForces[i] + _NearPressureForces[i] + _SurfaceTensionForces[i];
    float3 acceleration = totalForce / max(_Densities[i], 0.0001f);
    _Velocities[i] += acceleration * _DeltaTime;
    _Velocities[i] += _ViscosityForces[i] * _DeltaTime;
}

[numthreads(128, 1, 1)]
void UpdatePositions(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;

    float3 velocity = _Velocities[i];
    float3 position = _Positions[i] + velocity * _DeltaTime;

    float halfWidth  = _SimulationBounds.x * 0.5f;
    float halfHeight = _SimulationBounds.y * 0.5f;
    float halfDepth  = _SimulationBounds.z * 0.5f;

    if (position.x - _ParticleRadius < -halfWidth)
    {
        position.x = -halfWidth + _ParticleRadius;
        if (velocity.x < 0.0f) velocity.x *= -_DampingFactor;
    }
    else if (position.x + _ParticleRadius > halfWidth)
    {
        position.x = halfWidth - _ParticleRadius;
        if (velocity.x > 0.0f) velocity.x *= -_DampingFactor;
    }

    if (position.y - _ParticleRadius < -halfHeight)
    {
        position.y = -halfHeight + _ParticleRadius;
        if (velocity.y < 0.0f) velocity.y *= -_DampingFactor;
    }
    else if (position.y + _ParticleRadius > halfHeight)
    {
        position.y = halfHeight - _ParticleRadius;
        if (velocity.y > 0.0f) velocity.y *= -_DampingFactor;
    }

    if (position.z - _ParticleRadius < -halfDepth)
    {
        position.z = -halfDepth + _ParticleRadius;
        if (velocity.z < 0.0f) velocity.z *= -_DampingFactor;
    }
    else if (position.z + _ParticleRadius > halfDepth)
    {
        position.z = halfDepth - _ParticleRadius;
        if (velocity.z > 0.0f) velocity.z *= -_DampingFactor;
    }

    _Velocities[i] = velocity;
    _Positions[i] = position;
    _PredictedPositions[i] = position; 
}

float DensityKernel(float r, float h)
{
    if (r >= h)
        return 0.0f;
    float spikyPow2 = 15.0f / (2.0f * 3.14159265f * pow(h, 5));
    float diff = h - r;
    return spikyPow2 * diff * diff;
}

float NearDensityKernel(float distance, float h)
{
    float q = distance / h;
    if (q >= 1.0f)
        return 0.0f;
    float diff = 1.0f - q;
    return diff * diff * diff;
}

float NearDensityKernelDerivative(float distance, float h)
{
    float q = distance / h;
    if (q >= 1.0f)
        return 0.0f;
    float diff = 1.0f - q;
    return -3.0f * diff * diff / h;
}

float SpikyGradient(float r, float h)
{
    if (r >= h || r < 1e-5f)
        return 0.0f;
    float spikyPow2Grad = 15.0f / (3.14159265f * pow(h, 5));
    float diff = h - r;
    return -diff * spikyPow2Grad;
}

float3 ColorFieldKernelNormal(float3 offset, float distSq, float h)
{
    if (distSq >= h * h)
        return float3(0, 0, 0);
    float diff = h * h - distSq;
    float coeff = -945.0f / (32.0f * 3.14159265f * pow(h, 9));
    return coeff * diff * diff * offset;
}

float ColorFieldKernelLaplacian(float distSq, float h)
{
    if (distSq >= h * h)
        return 0.0f;
    float diff = h * h - distSq;
    float coeff = -945.0f / (32.0f * 3.14159265f * pow(h, 9));
    return coeff * diff * (3.0f * h * h - 7.0f * distSq);
}
